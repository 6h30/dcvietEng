<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window -->
    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="#F3F4F6"/>

    <!-- Panel -->
    <SolidColorBrush
        x:Key="PanelBackgroundBrush"
        Color="#FFFFFF"/>

    <!-- Borders -->
    <SolidColorBrush
        x:Key="BorderBrush"
        Color="#D9D9D9"/>

    <SolidColorBrush
        x:Key="SeparatorBrush"
        Color="#E1E1E1"/>

    <!-- Headers -->
    <SolidColorBrush
        x:Key="HeaderBackgroundBrush"
        Color="#F2F2F2"/>

    <!-- Text -->
    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="#333333"/>

    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="#777777"/>

    <SolidColorBrush
        x:Key="MutedTextBrush"
        Color="#999999"/>

</ResourceDictionary>