<UserControl x:Class="dcvietUI.Views.Material.ReinforcementDetailEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="160"
             d:DesignHeight="102"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <Grid HorizontalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <!-- LABEL -->
            <ColumnDefinition Width="78*"
                              MinWidth="0"/>

            <!-- INPUT -->
            <ColumnDefinition Width="58*"
                              MinWidth="0"/>

            <!-- UNIT -->
            <ColumnDefinition Width="24"/>

        </Grid.ColumnDefinitions>

        <!-- TITLE -->

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Text="CHI TIẾT CỐT THÉP"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="#555555"
                   VerticalAlignment="Center"/>

        <!-- CONCRETE COVER -->

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Lớp bảo vệ"
                   FontSize="10"
                   Foreground="#666666"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,1"
                 Style="{StaticResource InputTextBox}"
                 Text="{Binding ConcreteCover,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Margin="3,0,0,0"
                   Text="mm"
                   FontSize="9"
                   Foreground="#888888"
                   VerticalAlignment="Center"/>

        <!-- LAYER SPACING -->

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Hở lớp thép"
                   FontSize="10"
                   Foreground="#666666"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,1"
                 Style="{StaticResource InputTextBox}"
                 Text="{Binding ReinforcementLayerSpacing,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Margin="3,0,0,0"
                   Text="mm"
                   FontSize="9"
                   Foreground="#888888"
                   VerticalAlignment="Center"/>

    </Grid>

</UserControl>