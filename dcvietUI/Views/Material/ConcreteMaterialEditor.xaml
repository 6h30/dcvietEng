<UserControl x:Class="dcvietUI.Views.Material.ConcreteMaterialEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="125"
             d:DesignHeight="142"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <Grid HorizontalAlignment="Stretch">

        <Grid.RowDefinitions>

            <!-- TITLE -->
            <RowDefinition Height="20"/>

            <!-- CONCRETE GRADE -->
            <RowDefinition Height="22"/>

            <!-- MATERIAL PROPERTIES -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <!-- LABEL -->
            <ColumnDefinition Width="65"/>

            <!-- SPACING -->
            <ColumnDefinition Width="0"/>

            <!-- VALUE -->
            <ColumnDefinition Width="35"/>

            <!-- UNIT -->
            <ColumnDefinition Width="25"/>

        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextBlock
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   Text="BÊ TÔNG"
                   FontSize="10"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" Height="14"/>

        <!-- ================================================= -->
        <!-- CONCRETE GRADE -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Cấp độ bền"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <ComboBox Grid.Row="1"
                  Grid.Column="2"
                  Grid.ColumnSpan="2"
                  Margin="0,1,0,1"
                  ItemsSource="{Binding ConcreteGrades}"
                  SelectedItem="{Binding SelectedConcrete,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="Grade"
                  FontSize="10"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>

        <!-- ================================================= -->
        <!-- RB -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Rb"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Text="{Binding SelectedConcrete.Rb,
                                  StringFormat={}{0:F1}}"
                   FontSize="10"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="3"
                   Margin="5,0,0,0"
                   Text="MPa"
                   FontSize="9"
                   VerticalAlignment="Center" Height="12"/>

        <!-- ================================================= -->
        <!-- RBT -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Rbt"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="2"
                   Text="{Binding SelectedConcrete.Rbt,
                                  StringFormat={}{0:F2}}"
                   FontSize="10"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="3"
                   Margin="5,0,0,0"
                   Text="MPa"
                   FontSize="9"
                   VerticalAlignment="Center" Height="12"/>

        <!-- ================================================= -->
        <!-- RB,SER -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Rb,ser"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="2"
                   Text="{Binding SelectedConcrete.RbSer,
                                  StringFormat={}{0:F1}}"
                   FontSize="10"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="3"
                   Margin="5,0,0,0"
                   Text="MPa"
                   FontSize="9"
                   VerticalAlignment="Center" Height="12"/>

        <!-- ================================================= -->
        <!-- RBT,SER -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="Rbt,ser"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="2"
                   Text="{Binding SelectedConcrete.RbtSer,
                                  StringFormat={}{0:F2}}"
                   FontSize="10"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="3"
                   Margin="5,0,0,0"
                   Text="MPa"
                   FontSize="9"
                   VerticalAlignment="Center" Height="12"/>

        <!-- ================================================= -->
        <!-- EB -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="Eb"
                   FontSize="10"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="2"
                   Text="{Binding SelectedConcrete.Eb,
                                  StringFormat={}{0:F0}}"
                   FontSize="10"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Height="14"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="3"
                   Margin="5,0,0,0"
                   Text="MPa"
                   FontSize="9"
                   VerticalAlignment="Center" Height="12"/>

    </Grid>

</UserControl>