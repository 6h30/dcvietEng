<UserControl x:Class="dcvietUI.Views.Material.MaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="clr-namespace:dcvietUI.Views.Material"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="150"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <Grid Margin="6">

        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MATERIAL HEADER -->

        <Border Grid.Row="0"
                Margin="0,0,0,5"
                BorderBrush="#D9D9D9"
                BorderThickness="0,0,0,1">

            <DockPanel>

                <TextBlock Text="VẬT LIỆU VÀ CẤU TẠO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#444444"
                           VerticalAlignment="Center"/>

                <TextBlock Text="TCVN 5574:2018"
                           Margin="12,0,0,0"
                           FontSize="9"
                           Foreground="#888888"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

        <!-- MATERIAL CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- CONCRETE -->
                <ColumnDefinition Width="1.15*"/>

                <ColumnDefinition Width="1"/>

                <!-- LONGITUDINAL STEEL -->
                <ColumnDefinition Width="1*"/>

                <ColumnDefinition Width="1"/>

                <!-- STIRRUP STEEL -->
                <ColumnDefinition Width="1.05*"/>

                <ColumnDefinition Width="1"/>

                <!-- REINFORCEMENT DETAIL -->
                <ColumnDefinition Width="1.45*"/>

            </Grid.ColumnDefinitions>

            <material:ConcreteMaterialEditor
                Grid.Column="0"
                Margin="0,0,8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

            <Border Grid.Column="1"
                    Background="#E3E3E3"/>

            <material:LongitudinalSteelEditor
                Grid.Column="2"
                Margin="8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

            <Border Grid.Column="3"
                    Background="#E3E3E3"/>

            <material:StirrupSteelEditor
                Grid.Column="4"
                Margin="8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

            <Border Grid.Column="5"
                    Background="#E3E3E3"/>

            <material:ReinforcementDetailEditor
                Grid.Column="6"
                Margin="8,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

        </Grid>

    </Grid>

</UserControl>