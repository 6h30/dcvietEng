<UserControl x:Class="dcvietUI.Views.Material.SteelMaterialEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="425"
             d:DesignHeight="102"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <Grid HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>

            <!-- LONGITUDINAL STEEL -->
            <ColumnDefinition Width="150*"
                              MinWidth="0"/>

            <!-- SPACING -->
            <ColumnDefinition Width="20"/>

            <!-- STIRRUP STEEL 1 -->
            <ColumnDefinition Width="150*"
                              MinWidth="0"/>

            <!-- SPACING -->
            <ColumnDefinition Width="20"/>

            <!-- STIRRUP STEEL 2 -->
            <ColumnDefinition Width="85*"
                              MinWidth="0"/>

        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- LONGITUDINAL STEEL -->
        <!-- ================================================= -->

        <Grid Grid.Column="0"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"
                                  MinWidth="0"/>
                <ColumnDefinition Width="85*"
                                  MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="THÉP DỌC"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Nhóm thép"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding LongitudinalSteelGrades}"
                      SelectedItem="{Binding SelectedLongitudinalSteel,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Grade"
                      FontSize="10"
                      Margin="0,1"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Rs (MPa)"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding SelectedLongitudinalSteel.Rs,
                                      StringFormat={}{0:F0}}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Rsc (MPa)"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       Text="{Binding SelectedLongitudinalSteel.Rsc,
                                      StringFormat={}{0:F0}}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Es (MPa)"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Text="{Binding SelectedLongitudinalSteel.Es,
                                      StringFormat={}{0:F0}}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- ================================================= -->
        <!-- STIRRUP STEEL 1 -->
        <!-- ================================================= -->

        <Grid Grid.Column="2"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"
                                  MinWidth="0"/>
                <ColumnDefinition Width="85*"
                                  MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="THÉP ĐAI 1"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Nhóm thép"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding StirrupSteelGrades}"
                      SelectedItem="{Binding SelectedStirrupSteel,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Grade"
                      FontSize="10"
                      Margin="0,1"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Rsw (MPa)"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding SelectedStirrupSteel.Rsw,
                                      StringFormat={}{0:F0}}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- ================================================= -->
        <!-- STIRRUP STEEL 2 -->
        <!-- ================================================= -->

        <Grid Grid.Column="4"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="THÉP ĐAI 2"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding StirrupSteelGrades}"
                      SelectedItem="{Binding SelectedStirrupSteel,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Grade"
                      FontSize="10"
                      Margin="0,1"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding SelectedStirrupSteel.Rsw,
                                      StringFormat={}{0:F0}}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</UserControl>