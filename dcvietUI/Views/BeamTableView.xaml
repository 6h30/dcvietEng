<UserControl x:Class="dcvietUI.Views.BeamTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beam="clr-namespace:dcvietUI.Views.Beam"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="1200">

    <Grid Background="White">

        <Grid.RowDefinitions>

            <!-- FILTER -->
            <RowDefinition Height="Auto"/>

            <!-- TABLE -->
            <RowDefinition Height="*"/>

            <!-- STATUS -->
            <RowDefinition Height="24"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- FILTER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="#F7F7F7"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="6">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- STORY -->

                <TextBlock Grid.Column="0"
                           Text="Story:"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          Height="26"
                          Margin="0,0,14,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Stories}"
                          SelectedItem="{Binding SelectedStory}"/>


                <!-- STATUS -->

                <TextBlock Grid.Column="2"
                           Text="Status:"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="3"
                          Height="26"
                          Margin="0,0,14,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"/>


                <!-- SEARCH -->

                <TextBlock Grid.Column="4"
                           Text="Search:"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Column="5"
                         Height="26"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- BEAM TABLE -->
        <!-- CHỈ CÓ SCROLLVIEWER TẠI ĐÂY -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                ClipToBounds="True">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">

                <!--
                    BeamDataTableView chứa:
                    - BeamHeaderTemplate
                    - các BeamDataBlockView
                    - SharedSizeScope
                -->

                <beam:BeamDataTableView
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>

            </ScrollViewer>

        </Border>


        <!-- ================================================= -->
        <!-- STATUS BAR -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="#F2F2F2"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="6,0">

                <TextBlock Text="Beams: "
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding BeamCount}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>


                <TextBlock Text="    |    Pass: "
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding PassCount}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>


                <TextBlock Text="    |    Fail: "
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding FailCount}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>


                <TextBlock Text="    |    Selected: "
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding SelectedBeam.BeamEtabsName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>