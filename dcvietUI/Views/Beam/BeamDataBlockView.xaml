<UserControl x:Class="dcvietUI.Views.Beam.BeamDataBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- ===================================================== -->
        <!-- 22 COLUMNS - PHẢI GIỐNG BEAM DATA HEADER -->
        <!-- ===================================================== -->

        <Grid.ColumnDefinitions>

            <!-- ================= GENERAL : 0 - 2 ================= -->

            <ColumnDefinition SharedSizeGroup="Story"/>
            <ColumnDefinition SharedSizeGroup="BeamEtabs"/>
            <ColumnDefinition SharedSizeGroup="BeamDrawing"/>


            <!-- ================= SECTION : 3 - 4 ================= -->

            <ColumnDefinition SharedSizeGroup="SectionB"/>
            <ColumnDefinition SharedSizeGroup="SectionH"/>


            <!-- ================= FORCE : 5 - 8 ================= -->

            <ColumnDefinition SharedSizeGroup="ForceType"/>
            <ColumnDefinition SharedSizeGroup="ForceLeft"/>
            <ColumnDefinition SharedSizeGroup="ForceMiddle"/>
            <ColumnDefinition SharedSizeGroup="ForceRight"/>


            <!-- ================= REBAR : 9 - 12 ================= -->

            <ColumnDefinition SharedSizeGroup="MainRebar"/>
            <ColumnDefinition SharedSizeGroup="RebarLeft"/>
            <ColumnDefinition SharedSizeGroup="RebarMiddle"/>
            <ColumnDefinition SharedSizeGroup="RebarRight"/>


            <!-- ================= FLEXURE : 13 - 16 ================= -->

            <ColumnDefinition SharedSizeGroup="FlexureType"/>
            <ColumnDefinition SharedSizeGroup="FlexureLeft"/>
            <ColumnDefinition SharedSizeGroup="FlexureMiddle"/>
            <ColumnDefinition SharedSizeGroup="FlexureRight"/>


            <!-- ================= CRACK : 17 - 20 ================= -->

            <ColumnDefinition SharedSizeGroup="CrackType"/>
            <ColumnDefinition SharedSizeGroup="CrackLeft"/>
            <ColumnDefinition SharedSizeGroup="CrackMiddle"/>
            <ColumnDefinition SharedSizeGroup="CrackRight"/>


            <!-- ================= CHECK : 21 ================= -->

            <ColumnDefinition SharedSizeGroup="Check"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- 8 ROWS / BEAM -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>

            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="26"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- GENERAL -->
        <!-- MERGE 8 ROW -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="8"
                Style="{StaticResource BeamCellBorder}">

            <TextBlock Text="{Binding Story}"
                       Style="{StaticResource BeamCellText}"/>

        </Border>


        <Border Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="8"
                Style="{StaticResource BeamCellBorder}">

            <TextBlock Text="{Binding BeamEtabsName}"
                       Style="{StaticResource BeamCellText}"/>

        </Border>


        <Border Grid.Column="2"
                Grid.Row="0"
                Grid.RowSpan="8"
                Style="{StaticResource BeamCellBorder}">

            <TextBlock Text="{Binding BeamDrawingName}"
                       TextWrapping="Wrap"
                       Style="{StaticResource BeamCellText}"/>

        </Border>


        <!-- ===================================================== -->
        <!-- SECTION -->
        <!-- MERGE 8 ROW -->
        <!-- ===================================================== -->

        <Border Grid.Column="3"
                Grid.Row="0"
                Grid.RowSpan="8"
                Style="{StaticResource BeamCellBorder}">

            <TextBlock Text="{Binding Width,
                                     StringFormat=F0}"
                       Style="{StaticResource BeamCellText}"/>

        </Border>


        <Border Grid.Column="4"
                Grid.Row="0"
                Grid.RowSpan="8"
                Style="{StaticResource BeamCellBorder}">

            <TextBlock Text="{Binding Height,
                                     StringFormat=F0}"
                       Style="{StaticResource BeamCellText}"/>

        </Border>


        <!-- ===================================================== -->
        <!-- ROW DATA -->
        <!--
            ItemsControl chiếm CHÍNH XÁC column 5 -> 20
            tức 17 cột dữ liệu.
        -->
        <!-- ===================================================== -->

        <ItemsControl Grid.Column="5"
                      Grid.ColumnSpan="16"
                      Grid.Row="0"
                      Grid.RowSpan="8"
                      HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding Rows}"
                      ItemTemplate="{StaticResource BeamDataRowTemplate}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

        </ItemsControl>

        <!-- ROW 0 + ROW 1 -->

        <Border Grid.Column="21"
        Grid.Row="0"
        Grid.RowSpan="2"
         Tag="{Binding IsGroup1Passed}"
        Style="{StaticResource BeamCheckBorder}">

            <TextBlock Text="{Binding Group1CheckText}"
               Style="{StaticResource BeamCheckText}"/>

        </Border>

        <!-- ROW 2 -->

        <Border Grid.Column="21"
        Grid.Row="2"
         Tag="{Binding IsGroup2Passed}"
        Style="{StaticResource BeamCheckBorder}">

            <TextBlock Text="{Binding Group2CheckText}"
               Style="{StaticResource BeamCheckText}"/>

        </Border>

        <!-- ROW 3 + ROW 4 -->

        <Border Grid.Column="21"
        Grid.Row="3"
        Grid.RowSpan="2"
         Tag="{Binding IsGroup3Passed}"
        Style="{StaticResource BeamCheckBorder}">

            <TextBlock Text="{Binding Group3CheckText}"
               Style="{StaticResource BeamCheckText}"/>

        </Border>

        <!-- ROW 5 -->

        <Border Grid.Column="21"
        Grid.Row="5"
         Tag="{Binding IsGroup4Passed}"
        Style="{StaticResource BeamCheckBorder}">

            <TextBlock Text="{Binding Group4CheckText}"
               Style="{StaticResource BeamCheckText}"/>

        </Border>

        <!-- ROW 6 + ROW 7 -->

        <Border Grid.Column="21"
        Grid.Row="6"
        Grid.RowSpan="2"
         Tag="{Binding IsGroup5Passed}"
        Style="{StaticResource BeamCheckBorder}">

            <TextBlock Text="{Binding Group5CheckText}"
               Style="{StaticResource BeamCheckText}"/>

        </Border>


    </Grid>

</UserControl>
