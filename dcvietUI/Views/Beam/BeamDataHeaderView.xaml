<UserControl x:Class="dcvietUI.Views.Beam.BeamDataHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!--
        BEAM DATA HEADER

        22 columns:

        GENERAL     :  0 -  2
        SECTION     :  3 -  4
        FORCE       :  5 -  8
        REBAR       :  9 - 12
        FLEXURE     : 13 - 16
        CRACK       : 17 - 20
        CHECK       : 21

        SharedSizeGroup được dùng chung với:
        - BeamDataBlockView
        - BeamDataRowTemplate

        ScrollViewer nằm bên ngoài tại BeamTableView.
    -->
    <!-- ===================================================== -->

    <Grid>

        <!-- ================================================= -->
        <!-- COLUMNS -->
        <!-- ================================================= -->

        <Grid.ColumnDefinitions>

            <!-- ================= GENERAL ================= -->

            <ColumnDefinition Width="65"
                              SharedSizeGroup="Story"/>

            <ColumnDefinition Width="90"
                              SharedSizeGroup="BeamEtabs"/>

            <ColumnDefinition Width="100"
                              SharedSizeGroup="BeamDrawing"/>


            <!-- ================= SECTION ================= -->

            <ColumnDefinition Width="50"
                              SharedSizeGroup="SectionB"/>

            <ColumnDefinition Width="50"
                              SharedSizeGroup="SectionH"/>


            <!-- ================= FORCE ================= -->

            <ColumnDefinition Width="55"
                              SharedSizeGroup="ForceType"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="ForceLeft"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="ForceMiddle"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="ForceRight"/>


            <!-- ================= REBAR ================= -->

            <ColumnDefinition Width="65"
                              SharedSizeGroup="MainRebar"/>

            <ColumnDefinition Width="75"
                              SharedSizeGroup="RebarLeft"/>

            <ColumnDefinition Width="75"
                              SharedSizeGroup="RebarMiddle"/>

            <ColumnDefinition Width="75"
                              SharedSizeGroup="RebarRight"/>


            <!-- ================= FLEXURE ================= -->

            <ColumnDefinition Width="55"
                              SharedSizeGroup="FlexureType"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="FlexureLeft"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="FlexureMiddle"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="FlexureRight"/>


            <!-- ================= CRACK ================= -->

            <ColumnDefinition Width="55"
                              SharedSizeGroup="CrackType"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="CrackLeft"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="CrackMiddle"/>

            <ColumnDefinition Width="70"
                              SharedSizeGroup="CrackRight"/>


            <!-- ================= CHECK ================= -->

            <ColumnDefinition Width="80"
                              SharedSizeGroup="Check"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- HEADER ROWS -->
        <!-- ================================================= -->

        <Grid.RowDefinitions>

            <!-- GROUP -->
            <RowDefinition Height="22"/>

            <!-- SUB GROUP -->
            <RowDefinition Height="22"/>

            <!-- COLUMN -->
            <RowDefinition Height="22"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- GENERAL -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="3"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Tầng"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="3"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Tên dầm ETABS"
                       TextWrapping="Wrap"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="2"
                Grid.Row="0"
                Grid.RowSpan="3"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Tên dầm bản vẽ"
                       TextWrapping="Wrap"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- SECTION -->
        <!-- ================================================= -->

        <Border Grid.Column="3"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Kích thước dầm"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="3"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="b&#x0a;(mm)"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="4"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="h&#x0a;(mm)"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- FORCE -->
        <!-- ================================================= -->

        <Border Grid.Column="5"
                Grid.ColumnSpan="4"
                Grid.Row="0"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Nội lực dầm"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="5"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Type"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="6"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Trái"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="7"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Giữa"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="8"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Phải"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- REBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="9"
                Grid.ColumnSpan="4"
                Grid.Row="0"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Bố trí cốt thép"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="9"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Chạy suốt"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="10"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Trái"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="11"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Giữa"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="12"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Phải"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- RESULT -->
        <!-- FLEXURE + CRACK -->
        <!-- ================================================= -->

        <Border Grid.Column="13"
                Grid.ColumnSpan="8"
                Grid.Row="0"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Khả năng chịu lực &amp; Bề rộng vết nứt"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- FLEXURE -->
        <!-- ================================================= -->

        <Border Grid.Column="13"
                Grid.ColumnSpan="4"
                Grid.Row="1"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Khả năng chịu uốn"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="13"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Type"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="14"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Trái"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="15"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Giữa"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="16"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Phải"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- CRACK -->
        <!-- ================================================= -->

        <Border Grid.Column="17"
                Grid.ColumnSpan="4"
                Grid.Row="1"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Bề rộng vết nứt"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="17"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Type"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="18"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Trái"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="19"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Giữa"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <Border Grid.Column="20"
                Grid.Row="2"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Phải"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>


        <!-- ================================================= -->
        <!-- CHECK -->
        <!-- ================================================= -->

        <Border Grid.Column="21"
                Grid.Row="0"
                Grid.RowSpan="3"
                Style="{StaticResource BeamHeaderCell}">

            <TextBlock Text="Kiểm tra"
                       Style="{StaticResource BeamHeaderText}"/>

        </Border>

    </Grid>

</UserControl>

