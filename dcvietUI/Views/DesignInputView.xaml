<UserControl x:Class="dcvietUI.Views.DesignInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="clr-namespace:dcvietUI.Views.Material"
             xmlns:loadCombo="clr-namespace:dcvietUI.Views.LoadCombination"
             xmlns:tcvn="clr-namespace:dcvietUI.Views.TCVNparameters"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="150"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <!--
        Grid nhận toàn bộ ActualWidth từ BeamDesignWindow.
        Không đặt Width hoặc MinWidth cố định.
    -->
    <Grid Margin="4"
          HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>

            <!-- MATERIAL -->
            <ColumnDefinition Width="2.4*"/>

            <!-- SPACING -->
            <ColumnDefinition Width="8"/>

            <!-- LOAD COMBINATION -->
            <ColumnDefinition Width="0.65*"/>

            <!-- SPACING -->
            <ColumnDefinition Width="8"/>

            <!-- TCVN PARAMETERS -->
            <ColumnDefinition Width="0.55*"/>

        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- 1. MATERIAL -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <material:MaterialView
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

        </Border>

        <!-- ================================================= -->
        <!-- 2. LOAD COMBINATION -->
        <!-- ================================================= -->

        <Border Grid.Column="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <loadCombo:LoadCombinationView
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

        </Border>

        <!-- ================================================= -->
        <!-- 3. TCVN PARAMETERS -->
        <!-- ================================================= -->

        <Border Grid.Column="4"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <tcvn:TCVNParametersView
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"/>

        </Border>

    </Grid>

</UserControl>