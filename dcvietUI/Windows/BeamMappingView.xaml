<UserControl x:Class="dcvietUI.Windows.BeamMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ACTION BAR -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="6">

            <Button Content="Import ETABS"
                    Width="110"
                    Height="30"
                    Margin="0,0,6,0"/>

            <Button Content="Import Revit"
                    Width="110"
                    Height="30"
                    Margin="0,0,6,0"/>

            <Button Content="Auto Mapping"
                    Width="110"
                    Height="30"
                    Margin="0,0,6,0"/>

            <Button Content="Export Mapping"
                    Width="120"
                    Height="30"/>

        </StackPanel>


        <!-- MAPPING TABLE -->

        <DataGrid Grid.Row="1"
                  Margin="6"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Story"
                                    Binding="{Binding Story}"
                                    Width="80"/>

                <DataGridTextColumn Header="ETABS Beam"
                                    Binding="{Binding EtabsBeamName}"
                                    Width="120"/>

                <DataGridTextColumn Header="Revit Beam"
                                    Binding="{Binding RevitBeamName}"
                                    Width="140"/>

                <DataGridTextColumn Header="Section"
                                    Binding="{Binding Section}"
                                    Width="100"/>

                <DataGridTextColumn Header="Distance"
                                    Binding="{Binding Distance}"
                                    Width="100"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>