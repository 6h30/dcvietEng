<UserControl x:Class="dcvietUI.Windows.BeamDesignWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:dcvietUI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="850"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <!-- Không đặt ScrollViewer tại đây -->
    <Grid Margin="8">

        <Grid.RowDefinitions>

            <!-- Follow chiều cao nội dung -->
            <RowDefinition Height="Auto"/>

            <!-- Follow chiều cao nội dung -->
            <RowDefinition Height="Auto"/>

            <!-- Follow chiều cao nội dung -->
            <RowDefinition Height="Auto"/>

            <!-- Chiếm toàn bộ chiều cao còn lại -->
            <RowDefinition Height="*" MinHeight="0"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- 1. PROJECT INFO -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="8">

            <views:ProjectInfoView
                HorizontalAlignment="Stretch"/>

        </Border>

        <!-- ================================================= -->
        <!-- 2. DESIGN INPUT -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
        Margin="0,6,0,0"
        Background="{StaticResource PanelBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top">

            <views:DesignInputView
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"/>

        </Border>

        <!-- ================================================= -->
        <!-- 3. ACTION PANEL -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Margin="0,6,0,6"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="6">

            <views:ActionPanelView
                HorizontalAlignment="Stretch"/>

        </Border>

        <!-- ================================================= -->
        <!-- 4. BEAM TABLE -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
                MinHeight="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">

            <!-- BeamTableView tự quản lý ScrollViewer -->
            <views:BeamTableView
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        </Border>

    </Grid>

</UserControl>